{
  "name": "remixaustin-com",
  "version": "1.0.0",
  "private": true,
  "sideEffects": false,
  "scripts": {
    "build": "run-s build:posts build:remix",
    "build:remix": "remix build",
    "build:posts": "ts-node blog/buildPosts.ts",
    "dev": "run-p dev:*",
    "dev:remix": "binode --require ./mocks -- @remix-run/dev:remix dev",
    "dev:posts": "ts-node blog/blogDevWatch.ts",
    "clean": "rm -rf ./build ./public/build ./node_modules/.cache ./playwright-report",
    "format": "prettier --write --cache .",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/eslint .",
    "lint:fix": "eslint --cache --fix --cache-location ./node_modules/.cache/eslint .",
    "lint-staged": "lint-staged",
    "start": "remix-serve build/index.js",
    "prestart:mocks": "run-s clean build",
    "start:mocks": "binode --require ./mocks -- @remix-run/serve:remix-serve build/index.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage && open ./coverage/index.html",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:chrome": "playwright test --project=chromium",
    "test:e2e:firefox": "playwright test --project=firefox",
    "test:e2e:webkit": "playwright test --project=webkit",
    "prepare": "husky",
    "ts:app": "tsc",
    "ts:e2e": "tsc -b e2e",
    "ts": "run-p ts:*",
    "validate": "run-p test lint ts test:e2e",
    "validate:precommit": "run-s lint:fix format ts",
    "block-robots": "./tools/workflows/block-robots.sh"
  },
  "prettier": {},
  "eslintIgnore": [
    "/node_modules",
    "/build",
    "/public/build"
  ],
  "dependencies": {
    "@remix-run/node": "2.11.1",
    "@remix-run/react": "2.11.1",
    "@remix-run/serve": "2.11.1",
    "daisyui": "2.38.0",
    "esbuild": "^0.19.4",
    "isbot": "^3.5.3",
    "mdx-bundler": "^9.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remark-mdx-images": "^2.0.0",
    "tiny-invariant": "^1.3.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "1.46.0",
    "@remix-run/dev": "2.11.1",
    "@remix-run/eslint-config": "2.11.1",
    "@tailwindcss/typography": "0.5.14",
    "@testing-library/dom": "^8.18.1",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/eslint": "^8.56.7",
    "@types/node": "^20.12.4",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.5.12",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-c8": "^0.23.4",
    "autoprefixer": "^10.4.20",
    "binode": "^1.0.5",
    "c8": "^7.12.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "front-matter": "^4.0.2",
    "husky": "^9.1.4",
    "jsdom": "20.0.3",
    "lint-staged": "^13.2.1",
    "msw": "^0.47.3",
    "npm-run-all": "^4.1.5",
    "playwright": "1.46.0",
    "postcss": "^8.4.41",
    "prettier": "3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.6",
    "rimraf": "^5.0.5",
    "start-server-and-test": "^1.14.0",
    "sync-directory": "^6.0.5",
    "tailwindcss": "^3.4.9",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.5.4",
    "vite": "^3.1.3",
    "vite-tsconfig-paths": "^3.5.0",
    "vitest": "^0.23.4",
    "ws": "^8.18.0"
  },
  "engines": {
    "node": ">=20.16.0",
    "npm": ">=10.8.1"
  }
}
